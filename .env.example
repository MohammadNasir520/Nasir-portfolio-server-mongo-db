# Environment
NODE_ENV=development

# Server
PORT=5000

# Database
DATABASE_URL=mongodb+srv://<username>:<password>@<cluster>/<db>?retryWrites=true&w=majority

# Password hashing
BCRYPT_SALT_ROUNDS=12

# JWT
JWT_SECRET=replace_with_strong_random_secret
JWT_REFRESH_SECRET=replace_with_another_strong_random_secret
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=365d

# Security
CORS_ORIGINS=http://localhost:3000,https://mdnasir-uddin.vercel.app
MAX_BODY_SIZE=1mb
TRUST_PROXY=true
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=600
AUTH_RATE_LIMIT_WINDOW_MS=60000
AUTH_RATE_LIMIT_MAX=20

# Cloudinary — the dashboard uploads images straight from the browser using a
# signature minted by POST /api/v1/uploads/signature. The secret signs those
# requests and is never sent to the client.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_FOLDER=portfolio
